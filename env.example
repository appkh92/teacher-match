# ---------------------------------------------------------------------------
# Teacher Match - exemple de variables d'environnement
#
# Ce fichier ne contient AUCUNE valeur réelle.
# Il sert de modèle : en local, copiez-le en .env et remplissez les valeurs.
# Sur Railway, ces variables se saisissent dans l'onglet "Variables" du service.
# ---------------------------------------------------------------------------

# Variable fournie automatiquement par Railway quand vous ajoutez le plugin
# PostgreSQL. Format attendu :
# postgresql://utilisateur:motdepasse@hote:port/nom_de_la_base
DATABASE_URL=

# Clé API Anthropic (console.anthropic.com -> API Keys).
# Utilisée plus tard, côté serveur uniquement, pour l'analyse des syllabi.
ANTHROPIC_API_KEY=

# Modèle Claude à utiliser (facultatif, une valeur par défaut est appliquée).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Port d'écoute. Laisser vide sur Railway : la plateforme le fournit.
PORT=

# Taille maximale d'un document importé, en mégaoctets (10 par défaut).
MAX_FILE_SIZE_MB=10
